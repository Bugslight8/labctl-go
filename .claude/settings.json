{
  "permissions": {
    "allow": [
      "Bash(cmos *)",
      "Bash(.cmos/bin/cmos *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git add -A *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.npm",
        "~/.cargo",
        "~/go/pkg",
        "~/.gradle",
        "~/.m2",
        "~/Library/Caches"
      ],
      "denyWrite": [
        "./.cmos/evidence",
        "./.cmos/bin",
        "./.cmos/config.json",
        "./.cmos/CLAUDE.md",
        "./.claude/settings.json",
        "./.git/hooks",
        "./.git/config"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.netrc",
        "./**/.env",
        "./**/.env.local",
        "./**/.env.production"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "*.crates.io",
        "proxy.golang.org",
        "sum.golang.org",
        "repo.maven.apache.org",
        "services.gradle.org"
      ],
      "allowLocalBinding": true
    }
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.cmos/bin/cmos\" statusline"
  }
}
